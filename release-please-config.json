{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "calendar",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "include-component-in-tag": false,
      "changelog-sections": [
        { "type": "feat", "section": "Новое" },
        { "type": "fix", "section": "Исправления" },
        { "type": "refactor", "section": "Рефакторинг" },
        { "type": "docs", "section": "Документация" },
        { "type": "test", "section": "Тесты", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "chore", "section": "Прочее", "hidden": true }
      ]
    }
  }
}
